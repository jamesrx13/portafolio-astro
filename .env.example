# SMTP propio (Stalwart). El servidor las lee al enviar el formulario.
# No uses el prefijo PUBLIC_: estas credenciales no deben llegar al navegador.
# En Dokploy defínelas como variables de entorno de ejecución del contenedor,
# no solo como argumentos de build. El sitio arranca aunque falten; en ese caso
# POST /api/contact responde 503 sin tumbar la página.

# Servidor SMTP
SMTP_HOST=mail.jamesrudas.online

# 587 con STARTTLS, o 465 con SSL implícito
SMTP_PORT=587

# false = STARTTLS (puerto 587). true = SSL desde el inicio (puerto 465).
SMTP_SECURE=false

# Cuenta autenticada en el servidor de correo
SMTP_USER=
SMTP_PASS=

# Remitente del propio dominio (cabecera From)
MAIL_FROM=no-reply@jamesrudas.online

# Destino. Si se omite, el servidor usa contacto@jamesrudas.online
MAIL_TO=contacto@jamesrudas.online
